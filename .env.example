# Supabase (service role, server only)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Kylon — clinic room + agent member ids (`kylon workspace room member list <room>`). CLI auth: `kylon auth login`
KYLON_WORKSPACE_ID=
KYLON_ROOM_ID=
KYLON_AGENT_ID_RILEY=
KYLON_AGENT_ID_SAGE=
KYLON_AGENT_ID_IVY=
KYLON_AGENT_ID_PAX=
KYLON_AGENT_ID_PENNY=

# BAND — shared context. Register the backend as an external agent in BAND (its key → BAND_API_KEY),
# and put it in one clinic chat room (POST /agent/chats → id → BAND_ROOM_ID). BAND_API_URL defaults to https://api.band.ai/api/v1/agent
BAND_API_KEY=
BAND_ROOM_ID=

# Cal.com
CALCOM_API_KEY=
CALCOM_EVENT_TYPE_ID=
CLINIC_TIME_ZONE=America/Los_Angeles

# Ivy — network keys for this clinic and its doctor (match network_providers in supabase/seed.sql)
CLINIC_FACILITY_ID=agent-clinic
CLINIC_DOCTOR_NPI=1000000001

# n8n
N8N_INVOICE_WEBHOOK_URL=
N8N_SHARED_SECRET=

# AdaL + Celesto
ADAL_ELIGIBILITY_URL=
ADAL_MEMORY_URL=
ADAL_API_KEY=
CELESTO_SESSION_URL=
CELESTO_API_KEY=

# Paritok — hosted compression API (pk_live_… key from paritok.com → dashboard → API keys).
# PARITOK_API_URL defaults to https://www.paritok.com/api/compress
PARITOK_API_KEY=

# Finch
FINCH_API_URL=
FINCH_API_KEY=

# Masky — API key (masky.ai/developer); owner + avatar ids from GET https://masky.ai/api/avatars
MASKY_API_KEY=
MASKY_OWNER_ID=
MASKY_AVATAR_ID_RILEY=
MASKY_AVATAR_ID_SAGE=
MASKY_AVATAR_ID_IVY=
MASKY_AVATAR_ID_PAX=
MASKY_AVATAR_ID_PENNY=

# Staff routes (approve Rx etc.) require Authorization: Bearer <token>
CLINIC_STAFF_TOKEN=
